{
  "manifest_version": 3,
  "name": "AgentBeacon",
  "version": "0.1.0",
  "description": "Detect ChatGPT agent completion + runaway loops; push signals to 微信/钉钉/飞书 IM bots; cap tripwire.",
  "permissions": ["storage", "alarms", "runtime"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.feishu.cn/*",
    "https://open.feishu.cn/*",
    "https://oapi.dingtalk.com/*",
    "https://qyapi.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AgentBeacon"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
